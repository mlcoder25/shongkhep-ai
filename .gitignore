# ── Secrets / environment files ───────────────────────────────────────────────
# Ignore every .env variant, but keep the .example templates tracked
.env*
!.env*.example

# ── Python (backend) ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ── Node / Next.js (frontend) ─────────────────────────────────────────────────
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
*.tsbuildinfo

# ── Build artifacts ────────────────────────────────────────────────────────────
dist/
build/

# ── OS / editor junk ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Test / coverage ─────────────────────────────────────────────────────────────
.coverage
htmlcov/
