# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://shongkhep_user:shongkhep_pass@localhost:5432/shongkhep_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-in-production-use-long-random-string-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Shongkhep AI
APP_VERSION=2.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=120
CELERY_TASK_TIME_LIMIT=180

# ── AI Model ──────────────────────────────────────────────────────────────────
MODEL_NAME=google/mt5-small
MAX_SUMMARY_LENGTH=150
MIN_SUMMARY_LENGTH=40
MODEL_DEVICE=auto
MODEL_TORCH_DTYPE=auto

# ── Observability ─────────────────────────────────────────────────────────────
ENABLE_METRICS=true
METRICS_PATH=/metrics

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SECRET=admin-secret-change-this
